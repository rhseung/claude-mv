{
  "name": "@rhseung/claude-mv",
  "version": "0.1.0",
  "description": "프로젝트 디렉터리를 옮기면서 Claude Code 프로젝트 상태까지 같이 옮깁니다",
  "type": "module",
  "license": "MIT",
  "author": "rhseung <ryu@rhseung.me>",
  "homepage": "https://github.com/rhseung/claude-mv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhseung/claude-mv.git"
  },
  "bugs": {
    "url": "https://github.com/rhseung/claude-mv/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "mv",
    "rename",
    "migration"
  ],
  "bin": {
    "claude-mv": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint . --fix",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:version": "bun scripts/sync-version.ts",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run test",
    "version": "bun run sync:version && bun run build && git add plugin",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "citty": "^0.2.2",
    "env-paths": "^3.0.0",
    "execa": "^9.6.0",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.3.2",
    "fzf": "^0.5.2",
    "ink": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "p-limit": "^7.3.3",
    "pretty-bytes": "^7.1.3",
    "pretty-ms": "^9.3.1",
    "proper-lockfile": "^4.1.2",
    "ps-list": "^9.0.0",
    "react": "^18.3.1",
    "string-width": "^8.2.2",
    "tar": "^7.5.7",
    "ulid": "^3.0.2",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/write-file-atomic": "^4.0.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tempy": "^3.1.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
